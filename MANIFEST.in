include README.md LICENSE NOTICE CITATION.cff ASSET_MANIFEST.tsv
recursive-include src/compass_os/assets/models *.json *.npz *.pt
recursive-include src/compass_os/assets/third_party *
include src/compass_os/data/*.tsv src/compass_os/data/*.txt
recursive-include docs *.md
recursive-include tests *.py
recursive-include tests/fixtures *.tsv *.tsv.gz *.json *.md
recursive-include examples *.py

# 字节码绝不进入 sdist / wheel（vendored 包导入时会生成）
global-exclude __pycache__ *.py[cod]
